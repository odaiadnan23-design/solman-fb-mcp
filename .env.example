# Copy to .env and fill in for your SolMan Focused Build system. Do NOT commit .env.

# --- Target system ---
SOLMAN_HOST=your-solman-host.example.com   # SolMan Focused Build host (no scheme)
SOLMAN_PORT=44300
SAP_CLIENT=100
SAP_LANGUAGE=EN
# SOLMAN_CA_BUNDLE=/path/to/corporate-root.pem   # optional: enable TLS verification

# --- Focused Build config (landscape-specific) ---
SOLMAN_REQ_PROCESS_TYPE=S1BR               # requirement transaction type in your config
SOLDOC_DEFAULT_SCOPE=SAP_DEFAULT_SCOPE

# --- Defaults for create_requirement (get these via the list_lookup / soldoc tools) ---
SOLMAN_SOLUTION_ID=                        # SOLUTIONSet SolutionId
SOLMAN_BRANCH_ID=                          # branch id (SOLUTIONSet(..)/Branchs)
SOLMAN_OWNER_BP=                           # default owner Business Partner number
SOLMAN_OWNER_NAME=                         # default owner display name
SOLMAN_CATEGORY_ID=                        # mandatory category (CATEGORYSet CatId), e.g. a GxP flag
SOLMAN_TEAM_NAME=                          # requirements team name
SOLMAN_TEAM_BP=                            # requirements team BP number
SOLMAN_PLANNED_PROJECT=                    # default planned project (WPPROJECTSet Description)
SOLMAN_PLANNED_PROJECT_GUID=               # default planned project GUID

# --- Work Package targeting (release/project the WP builds under) ---
SOLMAN_WP_PROJECT=                         # WPPROJECTSet ProjectId (usually the _BUILD variant)
SOLMAN_WP_PROJECT_PHASE=                   # project phase GUID
SOLMAN_WP_RELEASE=                         # RequestedRelease description
SOLMAN_WP_RELEASE_COMPONENT=               # release component GUID
SOLMAN_WP_RELEASE_NUMBER=                  # release number, e.g. 9.0.0
SOLMAN_WP_DEV_TEAM_BP=                     # dev team BP number

# --- Optional overrides (defaults derive from home dir) ---
# SOLMAN_MCP_HOME=%USERPROFILE%\.solman-mcp
# SOLMAN_COOKIE_FILE=%USERPROFILE%\.solman-mcp\cookies.txt
# SOLMAN_EDGE_PROFILE=%USERPROFILE%\.solman-mcp\edge-profile

# --- Customizing Scout (scout.py) ---------------------------------------
# Systems Scout may READ, comma separated. Names must match your .vsp.json.
# Scout FAILS CLOSED: if this is unset it refuses every call. That is intended.
# List sandbox / development / validation systems only. NEVER list production:
# Scout is read-only, but a production configuration dump is still a document
# somebody has to look after, and nothing here needs one.
#SCOUT_SYSTEMS=dev,qa
# Path to the vsp binary (default: ~/.local/bin/vsp.exe)
#SCOUT_VSP_BIN=
# Seconds before a vsp call is killed (default 120). Scout will not sit waiting on
# a browser window; refresh sessions out of band: vsp sso refresh -s <sid>
#SCOUT_TIMEOUT=120
# Cap on rows per read (default 5000)
#SCOUT_MAX_ROWS=5000
# Person-level tables (PA0*, ADRC, KNA1, LFA1, BUT000 ...) are refused by default:
# they are not configuration, and a diff copies them somewhere new.
#SCOUT_ALLOW_PERSONAL_DATA=1
